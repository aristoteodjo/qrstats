APP_ENV=development
LISTEN_ADDR=:8110
LOG_LEVEL=info
DATABASE_URL=postgres://qrstats:qrstats@localhost:5470/qrstats?sslmode=disable
MIGRATE_ON_START=true
WEB_URL=http://localhost:3110
CORS_ALLOWED_ORIGINS=http://localhost:3110,http://127.0.0.1:3110,http://app.localhost:3110
AUTH_JWKS_URL=http://localhost:3110/api/auth/jwks
AUTH_ISSUER=http://localhost:3110
AUTH_AUDIENCE=qrstats-api
# 32+ random characters in production (openssl rand -hex 32). Keys the daily visitor hash.
VISITOR_SECRET=change-me-32-chars-minimum-xxxxxxxxxx
# true only behind Vercel or Cloudflare, which set the client IP and geolocation headers.
TRUST_PROXY_HEADERS=false
# The one header the edge overwrites with the client address (Cloudflare: CF-Connecting-IP).
CLIENT_IP_HEADER=X-Vercel-Forwarded-For
SWAGGER_ENABLED=true
TEST_DATABASE_URL=postgres://qrstats:qrstats@localhost:5470/qrstats_test?sslmode=disable
# Public address of this API, printed in every code (/r/<slug>).
SHORT_URL=http://localhost:8110
# AI artworks (Replicate). Empty disables the feature. Create the token at replicate.com, never commit it.
REPLICATE_API_TOKEN=
# Optional: model version (defaults to andreasjansson/illusion) and artworks per account per 24 h.
REPLICATE_ART_VERSION=
ART_DAILY_LIMIT=10
