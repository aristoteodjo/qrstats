{
    "swagger": "2.0",
    "info": {
        "description": "Dynamic QR codes: the printed code points at /r/{slug}, its target can change, every scan is counted.",
        "title": "qrstats API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/public/qr/{slug}": {
            "get": {
                "tags": [
                    "public"
                ],
                "summary": "What the landing page of a code may show (content hidden while locked or paused)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Printed slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.PublicView"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/public/qr/{slug}/unlock": {
            "post": {
                "tags": [
                    "public"
                ],
                "summary": "Open a password-protected code",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Printed slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Password",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.unlockInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.PublicView"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/qrcodes": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "qrcodes"
                ],
                "summary": "List the caller's QR codes, newest first",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page (1-based)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Rows per page (max 100)",
                        "name": "per_page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search in name, slug and content",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "active or paused",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "url, text, vcard, wifi, email, phone or sms",
                        "name": "kind",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "recent (default), oldest, updated, name or scans",
                        "name": "sort",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.QRCodePage"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "qrcodes"
                ],
                "summary": "Create a QR code",
                "parameters": [
                    {
                        "description": "QR code",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/service.CreateInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.QRCodeView"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/qrcodes/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "qrcodes"
                ],
                "summary": "One of the caller's QR codes",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.QRCodeView"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "qrcodes"
                ],
                "summary": "Delete a QR code and its scans",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "qrcodes"
                ],
                "summary": "Change what a QR code leads to, its look, its status or its password",
                "parameters": [
                    {
                        "type": "string",
                        "description": "QR code id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to change",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/service.PatchInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.QRCodeView"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/r/{slug}": {
            "get": {
                "description": "A link code goes straight to its target (with UTM parameters); every other case lands on the web page /q/{slug}.",
                "tags": [
                    "public"
                ],
                "summary": "What a printed code opens: counts the scan, then redirects",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Printed slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Found"
                    }
                }
            }
        },
        "/stats": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "stats"
                ],
                "summary": "Scan statistics over a period, for every code of the caller or one of them",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Narrow to one QR code",
                        "name": "qr_code_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "First day, YYYY-MM-DD (default: 29 days before to)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Last day, YYYY-MM-DD (default: today)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "IANA time zone the days are read in (default UTC)",
                        "name": "tz",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.Stats"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "invalid"
                },
                "error": {
                    "type": "string",
                    "example": "Adresse invalide."
                },
                "field": {
                    "type": "string",
                    "example": "content.url"
                }
            }
        },
        "handler.PublicView": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object"
                },
                "kind": {
                    "type": "string"
                },
                "locked": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                }
            }
        },
        "handler.QRCodePage": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.QRSummaryView"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "pages": {
                    "type": "integer"
                },
                "per_page": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "handler.QRCodeView": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object"
                },
                "created_at": {
                    "type": "string"
                },
                "design": {
                    "type": "object"
                },
                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "protected": {
                    "type": "boolean"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "slug": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "handler.QRSummaryView": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object"
                },
                "created_at": {
                    "type": "string"
                },
                "design": {
                    "type": "object"
                },
                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "last_scan_at": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "protected": {
                    "type": "boolean"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "scans": {
                    "type": "integer"
                },
                "slug": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "handler.unlockInput": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                }
            }
        },
        "service.Bucket": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "key": {
                    "type": "string"
                }
            }
        },
        "service.CreateInput": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object"
                },
                "design": {
                    "type": "object"
                },
                "kind": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                }
            }
        },
        "service.DayCount": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string"
                },
                "scans": {
                    "type": "integer"
                },
                "uniques": {
                    "type": "integer"
                }
            }
        },
        "service.PatchInput": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object"
                },
                "design": {
                    "type": "object"
                },
                "kind": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "description": "Password: absent keeps it, \"\" removes it, anything else replaces it.",
                    "type": "string"
                },
                "rules": {
                    "description": "Rules: absent keeps them; [] removes them. A kind change away from link always drops them.",
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "service.Stats": {
            "type": "object",
            "properties": {
                "breakdowns": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/service.Bucket"
                        }
                    }
                },
                "from": {
                    "type": "string"
                },
                "hours": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "previous": {
                    "$ref": "#/definitions/service.DayCount"
                },
                "scans": {
                    "type": "integer"
                },
                "series": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.DayCount"
                    }
                },
                "to": {
                    "type": "string"
                },
                "top_codes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/service.TopCode"
                    }
                },
                "uniques": {
                    "type": "integer"
                },
                "weekdays": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "service.TopCode": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "scans": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Better Auth JWT (EdDSA), sent as \"Bearer \u003ctoken\u003e\".",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}