VITE_ROOT_DOMAIN=localhost
# The Go API: /api/v1 for the app, /r/<slug> is what a printed code encodes.
VITE_API_URL=http://localhost:8110/api/v1
VITE_SHORT_URL=http://localhost:8110
BETTER_AUTH_URL=http://localhost:3110
BETTER_AUTH_SECRET=change-me-32-chars-minimum-xxxxxxxx
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3110,http://app.localhost:3110
AUTH_DATABASE_URL=postgres://qrstats:qrstats@localhost:5470/qrstats
MAINTENANCE_SECRET=change-me
# true serves the maintenance page (503) on every page; /api/maintenance/* stays reachable.
MAINTENANCE_MODE=false

# Production (Vercel): https URLs, BETTER_AUTH_TRUSTED_ORIGINS=https://<root>,https://app.<root>
# AUTH_DATABASE_URL falls back to DATABASE_URL. VITE_* are read at build time.
